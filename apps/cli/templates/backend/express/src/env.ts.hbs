import "dotenv/config";
import { z } from "zod";

// Checked once at startup, so a missing or malformed variable stops the server
// with a clear message instead of failing on the first request that needs it
const envSchema = z.object({
  PORT: z.coerce.number().int().positive().default(3000),
  // "*" allows every origin; otherwise a comma-separated list of origins
  CORS_ORIGIN: z
    .string()
    .default("*")
    .transform((value) =>
      value === "*" ? value : value.split(",").map((origin) => origin.trim())
    ),
{{#if (eq database 'prisma')}}
  DATABASE_URL: z.url(),
{{/if}}
{{#if (eq database 'drizzle')}}
  DATABASE_URL: z.url(),
{{/if}}
{{#if (eq database 'mongoose')}}
  MONGODB_URI: z.url(),
{{/if}}
{{#if useAuth}}
  BETTER_AUTH_SECRET: z
    .string()
    .min(32, "BETTER_AUTH_SECRET must be at least 32 characters"),
  // The public URL of this server; links in emails point here
  BETTER_AUTH_URL: z.url(),
  // Optional: GitHub and Google sign-in are turned on when both are set
  GITHUB_CLIENT_ID: z.string().optional(),
  GITHUB_CLIENT_SECRET: z.string().optional(),
  GOOGLE_CLIENT_ID: z.string().optional(),
  GOOGLE_CLIENT_SECRET: z.string().optional(),
  // Optional: without it, emails are printed to the log
  RESEND_API_KEY: z.string().optional(),
  EMAIL_FROM: z.string().default("onboarding@resend.dev"),
{{/if}}
{{#if useRemoteAuth}}
  // The monorepo's web app, which runs Better Auth and checks sessions
  AUTH_URL: z.url(),
{{/if}}
{{#if (eq payments 'stripe')}}
  STRIPE_SECRET_KEY: z.string().min(1, "Set STRIPE_SECRET_KEY to your Stripe secret key"),
  // From the webhook endpoint in the Stripe dashboard, or from "stripe listen"
  STRIPE_WEBHOOK_SECRET: z.string().min(1, "Set STRIPE_WEBHOOK_SECRET to your webhook signing secret"),
{{/if}}
{{#if (eq payments 'polar')}}
  POLAR_ACCESS_TOKEN: z.string().min(1, "Set POLAR_ACCESS_TOKEN to a Polar organization access token"),
  POLAR_WEBHOOK_SECRET: z.string().min(1, "Set POLAR_WEBHOOK_SECRET to your webhook secret"),
  // Tokens, products, and customers are separate in each Polar environment
  POLAR_SERVER: z.enum(["sandbox", "production"]).default("sandbox"),
{{/if}}
{{#if (eq ai 'vercel')}}
  // Read by the Vercel AI Gateway; optional so the server starts without it
  AI_GATEWAY_API_KEY: z.string().optional(),
  AI_MODEL: z.string().default("anthropic/claude-sonnet-5.5"),
{{/if}}
{{#if (eq ai 'tanstack')}}
  // Read by the OpenAI adapter; optional so the server starts without it
  OPENAI_API_KEY: z.string().optional(),
  AI_MODEL: z.string().default("gpt-6.1-sol"),
{{/if}}
});

const result = envSchema.safeParse(process.env);

if (!result.success) {
  console.error(
    `Invalid environment variables:\n${z.prettifyError(result.error)}`
  );
  process.exit(1);
}

export const env = result.data;

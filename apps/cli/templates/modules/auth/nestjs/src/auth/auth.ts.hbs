import { betterAuth } from "better-auth";
{{#if (eq database 'none')}}
import { memoryAdapter } from "better-auth/adapters/memory";
{{/if}}
{{#if (eq database 'prisma')}}
import { prismaAdapter } from "better-auth/adapters/prisma";
{{/if}}
{{#if (eq database 'drizzle')}}
import { drizzleAdapter } from "better-auth/adapters/drizzle";
{{/if}}
{{#if (eq database 'mongoose')}}
import { mongodbAdapter } from "better-auth/adapters/mongodb";
{{/if}}
import { bearer } from "better-auth/plugins";
{{#if (eq payments 'stripe')}}
import { stripe } from "@better-auth/stripe";
import Stripe from "stripe";
{{/if}}
{{#if (eq payments 'polar')}}
import { checkout, polar, portal, webhooks } from "@polar-sh/better-auth";
import { createPolarCore } from "@polar-sh/sdk/2026-10";
import {
  deleteExternalCustomers,
  updateExternalCustomers,
} from "@polar-sh/sdk/2026-10/services/customers";
{{/if}}
{{#if (eq database 'mongoose')}}
import type { Db } from "mongodb";
{{/if}}

{{#if (eq database 'drizzle')}}
import type { Database } from "../database/database.module.js";
{{/if}}
import { env } from "../env.js";
{{#if (eq database 'prisma')}}
import type { PrismaService } from "../prisma/prisma.service.js";
{{/if}}
import { sendEmail } from "./email.js";

{{#if (eq database 'none')}}
// In-memory store for trying the API out: users and sessions are lost on
// restart, so add a database before going to production
const memoryDb = { user: [], session: [], account: [], verification: [] };

{{/if}}
// Reports a failed email instead of failing the request: the sign-up or reset
// already happened, and the user can ask for the email again
function deliver(email: Parameters<typeof sendEmail>[0]): void {
  sendEmail(email).catch((error: unknown) => {
    console.error(`Could not send "${email.subject}" to ${email.to}:`, error);
  });
}

// Points a verification link at the API itself when the client gave no page
// to return to, so opening it answers with JSON instead of a redirect to "/"
function withoutDefaultCallback(url: string): string {
  const link = new URL(url);
  if (link.searchParams.get("callbackURL") === "/") {
    link.searchParams.delete("callbackURL");
  }
  return link.toString();
}

{{#if (eq payments 'polar')}}
// Tokens, products, and customers are separate in each Polar environment
const polarClient = createPolarCore({
  accessToken: env.POLAR_ACCESS_TOKEN,
  environment: env.POLAR_SERVER,
});

// Keeps the user's Polar customer in step with the user. A user who has not
// bought anything has no customer yet (404). Other failures are logged, so a
// Polar outage never blocks a profile change or an account deletion
async function syncPolarCustomer(
  action: string,
  call: () => Promise<unknown>
): Promise<void> {
  try {
    await call();
  } catch (error) {
    if ((error as { statusCode?: number }).statusCode === 404) return;
    console.error(`Could not ${action} the Polar customer:`, error);
  }
}

{{/if}}
// Builds the Better Auth server; auth.module.ts calls it with the database
{{#if (eq database 'none')}}
export function createAuth() {
{{/if}}
{{#if (eq database 'prisma')}}
export function createAuth(prisma: PrismaService) {
{{/if}}
{{#if (eq database 'drizzle')}}
export function createAuth(db: Database) {
{{/if}}
{{#if (eq database 'mongoose')}}
export function createAuth(db: Db) {
{{/if}}
  return betterAuth({
{{#if (eq payments 'polar')}}
    // The Polar plugin does this only with createCustomerOnSignUp, which is off
    databaseHooks: {
      user: {
        update: {
          after: (user) =>
            syncPolarCustomer("update", () =>
              updateExternalCustomers(polarClient)(user.id, {
                email: user.email,
                name: user.name,
              })
            ),
        },
        delete: {
          after: (user) =>
            syncPolarCustomer("delete", () =>
              deleteExternalCustomers(polarClient)(user.id)
            ),
        },
      },
    },
{{/if}}
    {{#if (eq database 'none')}}
    database: memoryAdapter(memoryDb),
    {{/if}}
    {{#if (eq database 'prisma')}}
    database: prismaAdapter(prisma, { provider: "postgresql" }),
    {{/if}}
    {{#if (eq database 'drizzle')}}
    database: drizzleAdapter(db, { provider: "pg" }),
    {{/if}}
    {{#if (eq database 'mongoose')}}
    // Without the client, writes run without transactions, which a standalone
    // MongoDB server (no replica set) does not support
    database: mongodbAdapter(db),
    {{/if}}
    secret: env.BETTER_AUTH_SECRET,
    baseURL: env.BETTER_AUTH_URL,
    // Browser apps on these origins may call the auth routes with cookies
    trustedOrigins: typeof env.CORS_ORIGIN === "string" ? [] : env.CORS_ORIGIN,
    emailAndPassword: {
      enabled: true,
      // Set to true to block sign-in until the email address is verified
      requireEmailVerification: false,
      // A reset signs the user out everywhere
      revokeSessionsOnPasswordReset: true,
      sendResetPassword: ({ user, url, token }) => {
        deliver({
          to: user.email,
          subject: "Reset your password",
          text: `Open this link to choose a new password:\n${url}\n\nOr send this token to POST /api/auth/reset-password: ${token}`,
        });
        return Promise.resolve();
      },
    },
    emailVerification: {
      sendOnSignUp: true,
      autoSignInAfterVerification: true,
      sendVerificationEmail: ({ user, url }) => {
        deliver({
          to: user.email,
          subject: "Verify your email address",
          text: `Open this link to verify your email address:\n${withoutDefaultCallback(url)}`,
        });
        return Promise.resolve();
      },
    },
    // Each provider is turned on once its client ID and secret are set
    socialProviders: {
      ...(env.GITHUB_CLIENT_ID && env.GITHUB_CLIENT_SECRET
        ? {
            github: {
              clientId: env.GITHUB_CLIENT_ID,
              clientSecret: env.GITHUB_CLIENT_SECRET,
            },
          }
        : {}),
      ...(env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET
        ? {
            google: {
              clientId: env.GOOGLE_CLIENT_ID,
              clientSecret: env.GOOGLE_CLIENT_SECRET,
            },
          }
        : {}),
    },
    // Clients without cookies send "Authorization: Bearer <token>"; the token
    // comes back in the set-auth-token header of sign-in and sign-up
{{#if (eq payments 'none')}}
    plugins: [bearer()],
{{else}}
    plugins: [
      bearer(),
{{#if (eq payments 'stripe')}}
      // Stripe Checkout and the billing portal for subscriptions. The webhook on
      // /api/auth/stripe/webhook keeps the subscription table in sync
      stripe({
        stripeClient: new Stripe(env.STRIPE_SECRET_KEY),
        stripeWebhookSecret: env.STRIPE_WEBHOOK_SECRET,
        createCustomerOnSignUp: true,
        subscription: {
          enabled: true,
          // One entry per Stripe price, for example
          // { name: "pro", priceId: "price_..." }
          plans: [],
        },
      }),
{{/if}}
{{#if (eq payments 'polar')}}
      // Polar checkout and the customer portal. The webhook on
      // /api/auth/polar/webhooks checks each event's signature
      polar({
        client: polarClient,
        // Checkout creates the Polar customer from the user ID. Creating it at
        // sign-up would fail the sign-up, after the user is saved, whenever Polar
        // refuses the email or is down
        createCustomerOnSignUp: false,
        use: [
          // authClient.checkout({ products: ["<product id>"] }) starts a checkout
          checkout({ authenticatedUsersOnly: true }),
          portal(),
          // Add handlers such as onOrderPaid for the events your app needs
          webhooks({ secret: env.POLAR_WEBHOOK_SECRET }),
        ],
      }),
{{/if}}
    ],
{{/if}}
    {{#if useRateLimit}}
    // Sign-up, sign-in, and password reset: 10 attempts per client IP in 15
    // minutes, against password guessing
    rateLimit: {
      enabled: true,
      window: 15 * 60,
      max: 100,
      customRules: {
        "/sign-in/*": { window: 15 * 60, max: 10 },
        "/sign-up/*": { window: 15 * 60, max: 10 },
        "/request-password-reset": { window: 15 * 60, max: 10 },
      },
    },
    {{/if}}
    advanced: {
      // Set from req.ip on every request (see auth.module.ts)
      ipAddress: { ipAddressHeaders: ["x-client-ip"] },
    },
  });
}

import {
  Body,
  Controller,
  Get,
  HttpCode,
  Post,
  Req,
  UseGuards,
} from "@nestjs/common";
{{#if useRateLimit}}
import { Throttle } from "@nestjs/throttler";
{{/if}}

import { type AuthenticatedRequest, AuthGuard } from "./auth.guard.js";
import {
  type LoginInput,
  loginSchema,
  type RegisterInput,
  registerSchema,
} from "./auth.schemas.js";
import { type AuthResponse, AuthService } from "./auth.service.js";
import type { AuthTokenPayload } from "./jwt.js";
import { ZodValidationPipe } from "./zod-validation.pipe.js";

{{#if useRateLimit}}
// Sign-up and login: 10 attempts per client IP in 15 minutes, against
// password guessing
const AUTH_LIMIT = { default: { ttl: 15 * 60 * 1000, limit: 10 } };

{{/if}}
@Controller("auth")
export class AuthController {
  constructor(private readonly authService: AuthService) {}

  @Post("register")
  {{#if useRateLimit}}
  @Throttle(AUTH_LIMIT)
  {{/if}}
  register(
    @Body(new ZodValidationPipe(registerSchema)) body: RegisterInput
  ): Promise<AuthResponse> {
    return this.authService.register(body);
  }

  @Post("login")
  @HttpCode(200)
  {{#if useRateLimit}}
  @Throttle(AUTH_LIMIT)
  {{/if}}
  login(
    @Body(new ZodValidationPipe(loginSchema)) body: LoginInput
  ): Promise<AuthResponse> {
    return this.authService.login(body);
  }

  @Get("me")
  @UseGuards(AuthGuard)
  me(@Req() request: AuthenticatedRequest): { user?: AuthTokenPayload } {
    return { user: request.user };
  }
}

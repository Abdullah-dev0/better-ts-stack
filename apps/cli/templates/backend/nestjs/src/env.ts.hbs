import "dotenv/config";
import { z } from "zod";

// Checked once at startup, so a missing or malformed variable stops the server
// with a clear message instead of failing on the first request that needs it
const envSchema = z.object({
  PORT: z.coerce.number().int().positive().default(3000),
  // "*" allows every origin; otherwise a comma-separated list of origins
  CORS_ORIGIN: z
    .string()
    .default("*")
    .transform((value) =>
      value === "*" ? value : value.split(",").map((origin) => origin.trim())
    ),
{{#if (eq database 'prisma')}}
  DATABASE_URL: z.url(),
{{/if}}
{{#if (eq database 'drizzle')}}
  DATABASE_URL: z.url(),
{{/if}}
{{#if (eq database 'mongoose')}}
  MONGODB_URI: z.url(),
{{/if}}
{{#if useAuth}}
  BETTER_AUTH_SECRET: z
    .string()
    .min(32, "BETTER_AUTH_SECRET must be at least 32 characters"),
  // The public URL of this server; links in emails point here
  BETTER_AUTH_URL: z.url(),
  // Optional: GitHub and Google sign-in are turned on when both are set
  GITHUB_CLIENT_ID: z.string().optional(),
  GITHUB_CLIENT_SECRET: z.string().optional(),
  GOOGLE_CLIENT_ID: z.string().optional(),
  GOOGLE_CLIENT_SECRET: z.string().optional(),
  // Optional: without it, emails are printed to the log
  RESEND_API_KEY: z.string().optional(),
  EMAIL_FROM: z.string().default("onboarding@resend.dev"),
{{/if}}
});

const result = envSchema.safeParse(process.env);

if (!result.success) {
  console.error(
    `Invalid environment variables:\n${z.prettifyError(result.error)}`
  );
  process.exit(1);
}

export const env = result.data;

import "dotenv/config";
import { z } from "zod";

// Checked once at startup, so a missing or malformed variable stops the server
// with a clear message instead of failing on the first request that needs it
const envSchema = z.object({
  PORT: z.coerce.number().int().positive().default(3000),
  // "*" allows every origin; otherwise a comma-separated list of origins
  CORS_ORIGIN: z
    .string()
    .default("*")
    .transform((value) =>
      value === "*" ? value : value.split(",").map((origin) => origin.trim())
    ),
{{#if (eq database 'prisma')}}
  DATABASE_URL: z.url(),
{{/if}}
{{#if (eq database 'drizzle')}}
  DATABASE_URL: z.url(),
{{/if}}
{{#if (eq database 'mongoose')}}
  MONGODB_URI: z.url(),
{{/if}}
{{#if useAuth}}
  JWT_SECRET: z.string().min(32, "JWT_SECRET must be at least 32 characters"),
  JWT_EXPIRES_IN: z.string().default("1h"),
{{/if}}
});

const result = envSchema.safeParse(process.env);

if (!result.success) {
  console.error(
    `Invalid environment variables:\n${z.prettifyError(result.error)}`
  );
  process.exit(1);
}

export const env = result.data;

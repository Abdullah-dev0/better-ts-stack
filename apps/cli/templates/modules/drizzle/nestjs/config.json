{
  "id": "drizzle",
  "name": "Drizzle ORM",
  "description": "Drizzle ORM for NestJS with PostgreSQL",
  "type": "database",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "@types/pg": "^8.23.1"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "envVars": {
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/postgres"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}

{{#if (eq framework 'nextjs')}}
# Base stage
FROM node:24-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

# Dependencies stage
FROM base AS deps
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Build stage
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
{{#if (eq database 'prisma')}}
RUN DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres" npm run build
{{else if (eq database 'mongoose')}}
RUN MONGODB_URI="mongodb://localhost:27017/build" npm run build
{{else}}
RUN npm run build
{{/if}}

# Production stage
FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE {{port}}
ENV PORT={{port}} HOSTNAME=0.0.0.0

CMD ["node", "server.js"]

{{else}}
# Build stage
FROM node:24-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY . .

# Only build if package.json has a build script
{{#if (eq database 'prisma')}}
RUN DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres" npm run build
{{else if (eq database 'mongoose')}}
RUN MONGODB_URI="mongodb://localhost:27017/build" npm run build
{{else}}
RUN npm run build
{{/if}}

# Production stage
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 expressuser

COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

# Copy built files (if TypeScript) or source files (if JavaScript)
COPY --from=builder --chown=expressuser:nodejs /app/dist ./dist

USER expressuser
EXPOSE {{port}}
ENV PORT={{port}}

CMD ["node", "dist/index.js"]
{{/if}}
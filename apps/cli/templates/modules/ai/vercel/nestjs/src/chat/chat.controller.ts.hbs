import { BadRequestException, Body, Controller, Post, Res } from "@nestjs/common";
import {
  convertToModelMessages,
  pipeUIMessageStreamToResponse,
  streamText,
  toUIMessageStream,
  type UIMessage,
} from "ai";
import type { Response } from "express";

import { env } from "../env.js";

{{#unless useAuth}}
// Without auth anyone can call this route, and every reply is billed to your
// key: add auth or rate limiting before deploying
{{/unless}}
// Streams the model's reply as a UI message stream, the format useChat from
// @ai-sdk/react reads.{{#if useAuth}} The global auth guard answers 401 without
// a session.{{/if}}
@Controller("api/chat")
export class ChatController {
  @Post()
  async chat(
    @Body() body: { messages?: UIMessage[] },
    @Res() res: Response
  ): Promise<void> {
    if (!Array.isArray(body?.messages)) {
      throw new BadRequestException("messages must be an array");
    }

    // The client closing the request (the stop button) stops the model call
    const controller = new AbortController();
    res.on("close", () => controller.abort());

    const result = streamText({
      model: env.AI_MODEL,
      messages: await convertToModelMessages(body.messages),
      abortSignal: controller.signal,
    });

    // no-transform keeps a proxy, such as a Next.js rewrite, from gzipping the
    // stream and holding it back until the reply is finished
    await pipeUIMessageStreamToResponse({
      response: res,
      headers: { "cache-control": "no-cache, no-transform" },
      stream: toUIMessageStream({ stream: result.stream }),
    });
  }
}

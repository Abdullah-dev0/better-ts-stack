import "dotenv/config";
import express, { Express, Request, Response, NextFunction } from "express";
import cors from "cors";
import helmet from "helmet";
import morgan from "morgan";
import { env } from "./env";
{{#if (eq database 'prisma')}}
import { disconnectPrisma } from "./lib/prisma";
{{/if}}
{{#if (eq database 'drizzle')}}
import { db } from "./lib/db";
{{/if}}
{{#if (eq database 'mongoose')}}
import { connectDB, disconnectDB } from "./lib/db";
{{/if}}
{{#if useRateLimit}}
import { apiLimiter } from "./middleware/rateLimit";
{{/if}}
import healthRouter from "./routes/health";
{{#if useAuth}}
import authRouter from "./routes/auth";
{{/if}}

const app: Express = express();
const port = env.PORT;

// Middleware
app.use(helmet());
app.use(cors({ origin: env.CORS_ORIGIN }));
{{#if useRateLimit}}
app.use(apiLimiter);
{{/if}}
app.use(morgan("dev"));
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// Routes
app.use("/health", healthRouter);
{{#if useAuth}}
app.use("/auth", authRouter);
{{/if}}

// 404 handler
app.use((_req: Request, res: Response) => {
  res.status(404).json({ error: "Not Found" });
});

// Error handler
app.use(
  (
    err: Error & { status?: number; statusCode?: number; expose?: boolean },
    _req: Request,
    res: Response,
    _next: NextFunction,
  ) => {
    // Middleware such as express.json() sets 4xx statuses (bad JSON, body too large)
    const status = err.status ?? err.statusCode ?? 500;

    if (status >= 400 && status < 500) {
      res.status(status).json({ error: err.expose ? err.message : "Bad Request" });
      return;
    }

    console.error(err.stack);
    res.status(500).json({ error: "Internal Server Error" });
  },
);

// Closes the database connection once the server has stopped
function closeDatabase(): Promise<void> {
{{#if (eq database 'prisma')}}
  return disconnectPrisma();
{{else if (eq database 'drizzle')}}
  return db.$client.end();
{{else if (eq database 'mongoose')}}
  return disconnectDB();
{{else}}
  return Promise.resolve();
{{/if}}
}

function listen(): void {
  const server = app.listen(port, () => {
    console.log(`Server is running on http://localhost:${port}
    Health: http://localhost:${port}/health
    `);
  });

  // Docker and most hosts stop the process with SIGTERM, and Ctrl+C sends
  // SIGINT: finish open requests, close the database, then exit
  const shutdown = () => {
    server.close(() => {
      void closeDatabase().finally(() => process.exit(0));
    });
  };
  process.once("SIGTERM", shutdown);
  process.once("SIGINT", shutdown);
}

{{#if (eq database 'mongoose')}}
void connectDB()
  .then(listen)
  .catch((error: unknown) => {
    console.error(error);
    process.exitCode = 1;
  });
{{else}}
listen();
{{/if}}

export default app;

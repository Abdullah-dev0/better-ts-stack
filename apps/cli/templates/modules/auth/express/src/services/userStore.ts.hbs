{{#if (eq database 'drizzle')}}
import { eq } from "drizzle-orm";
import { db } from "../lib/db";
import { users } from "../lib/schema";
{{/if}}
{{#if (eq database 'none')}}
import crypto from 'crypto';
{{/if}}
{{#if (eq database 'prisma')}}
import { prisma } from '../lib/prisma';
{{/if}}
{{#if (eq database 'mongoose')}}
import UserModel from '../models/User';
{{/if}}

export interface AuthUser {
  id: string;
  email: string;
  name?: string | null;
  password: string;
}

export interface CreateUserInput {
  email: string;
  name?: string | null;
  password: string;
}

{{#if (eq database 'none')}}
const users: AuthUser[] = [];
{{/if}}

export {{#unless (eq database 'none')}}async {{/unless}}function findUserByEmail(email: string): Promise<AuthUser | null> {
  {{#if (eq database 'drizzle')}}
  const [user] = await db.select().from(users).where(eq(users.email, email)).limit(1);
  return user ?? null;
  {{/if}}
  {{#if (eq database 'prisma')}}
  return await prisma.user.findUnique({ where: { email } });
  {{/if}}

  {{#if (eq database 'mongoose')}}
  const user = await UserModel.findOne({ email }).exec();
  if (!user) return null;
  return {
    id: String(user._id),
    email: user.email,
    name: user.name,
    password: user.password,
  };
  {{/if}}

  {{#if (eq database 'none')}}
  const user = users.find((candidate) => candidate.email === email);
  return Promise.resolve(user ?? null);
  {{/if}}
}

export {{#unless (eq database 'none')}}async {{/unless}}function createUser(data: CreateUserInput): Promise<AuthUser> {
  {{#if (eq database 'drizzle')}}
  const [user] = await db.insert(users).values(data).returning();
  return user;
  {{/if}}
  {{#if (eq database 'prisma')}}
  return await prisma.user.create({ data });
  {{/if}}

  {{#if (eq database 'mongoose')}}
  const user = await UserModel.create(data);

  return {
    id: String(user._id),
    email: user.email,
    name: user.name,
    password: user.password,
  };
  {{/if}}

  {{#if (eq database 'none')}}
  // Enforce unique emails like a database constraint would, so a sign-up that
  // raced past the findUserByEmail check is rejected instead of duplicated
  if (users.some((candidate) => candidate.email === data.email)) {
    return Promise.reject(
      Object.assign(new Error('User already exists'), { code: 'DUPLICATE_EMAIL' }),
    );
  }

  const newUser: AuthUser = {
    id: crypto.randomUUID(),
    email: data.email,
    name: data.name,
    password: data.password,
  };

  users.push(newUser);
  return Promise.resolve(newUser);
  {{/if}}
}

// Unique-constraint error codes: Prisma, PostgreSQL (Drizzle wraps it in `cause`),
// MongoDB, and the in-memory store
const DUPLICATE_KEY_CODES = new Set<unknown>(['P2002', '23505', 11000, 'DUPLICATE_EMAIL']);

// True when an insert failed because the email is already taken (e.g. concurrent sign-ups)
export function isDuplicateEmailError(error: unknown): boolean {
  let current = error;
  for (let depth = 0; depth < 5 && current && typeof current === 'object'; depth++) {
    if (DUPLICATE_KEY_CODES.has((current as { code?: unknown }).code)) return true;
    current = (current as { cause?: unknown }).cause;
  }
  return false;
}

export function toPublicUser(user: AuthUser): Omit<AuthUser, 'password'> {
  const { id, email, name } = user;
  return { id, email, name };
}
